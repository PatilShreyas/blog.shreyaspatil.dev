---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ...props } = data;
---

<li class="group my-8 transition-all">
  <a
    href={getPath(id, filePath)}
    class:list={[
      "inline-block text-xl font-bold text-foreground decoration-accent/30 decoration-2 underline-offset-8 transition-all hover:text-accent hover:underline sm:text-2xl",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
  </a>
  <div class="mt-2 opacity-80">
    <Datetime {...props} />
  </div>
  <p class="mt-2 line-clamp-2 text-foreground/80 leading-relaxed">{description}</p>
</li>
